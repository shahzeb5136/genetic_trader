# Copy to .env and fill in. .env is gitignored.

# Identity sent to SEC/Wikipedia. Must include a real contact address.
SP500LAB_USER_AGENT="sp500lab/0.1 (research; you@example.com)"

# Optional. FRED works without a key via the CSV endpoint; a key unlocks the full API.
FRED_API_KEY=

# Phase 3 - not used yet. Purchased separately, see docs/DECISIONS.md ADR-002.
EODHD_API_TOKEN=
